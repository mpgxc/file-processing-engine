# Local MiniStack profile (copy to .env.local)
LOCAL=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DYNAMODB_ENDPOINT=http://localhost:4566
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_S3_ENDPOINT=http://localhost:4566
AWS_SES_ENDPOINT=http://localhost:4566

# DynamoDB
JOBS_TABLE_NAME=report_jobs
TEMPLATES_TABLE_NAME=report_templates

# S3
TEMPLATE_BUCKET_NAME=report-service-templates-local
OUTPUT_BUCKET_NAME=report-service-outputs-local

# SQS
SQS_PDF_QUEUE_URL=http://localhost:4566/000000000000/report-pdf-queue
SQS_CSV_QUEUE_URL=http://localhost:4566/000000000000/report-csv-queue
SQS_XLSX_QUEUE_URL=http://localhost:4566/000000000000/report-xlsx-queue
SQS_TXT_QUEUE_URL=http://localhost:4566/000000000000/report-txt-queue

# Auth / Mail
JWT_SECRET=dev-secret
SES_FROM_ADDRESS=noreply@dev.local

# Mounts (LOCAL=true applies local folders)
TEMPLATES_MOUNT_PATH=./fixtures/templates
OUTPUTS_MOUNT_PATH=./fixtures/outputs

# Logging
LOG_LEVEL=INFO
