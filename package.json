{
  "name": "report-service",
  "version": "1.0.0",
  "description": "Report generation service — NestJS REST API (ECS Fargate) + Lambda SQS workers + DynamoDB + S3 Files + SES",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:lambda:pdf": "esbuild src/workers/pdf-worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/pdf-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets",
    "build:lambda:csv": "esbuild src/workers/csv-worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/csv-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core",
    "build:lambda:xlsx": "esbuild src/workers/xlsx-worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/xlsx-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core",
    "build:lambda:txt": "esbuild src/workers/txt-worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/txt-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core --external:exceljs",
    "build:lambdas": "npm run build:lambda:pdf && npm run build:lambda:csv && npm run build:lambda:xlsx && npm run build:lambda:txt",
    "build:docker": "docker build -t report-service-api .",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "seed:local": "tsx scripts/seed-local.ts",
    "start:local": "dotenv -e .env.local -- cross-env LOCAL=true tsx watch src/main.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.15.0",
    "@aws-lambda-powertools/metrics": "^2.15.0",
    "@aws-lambda-powertools/tracer": "^2.15.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-ses": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@sparticuz/chromium-min": "^133.0.0",
    "csv-stringify": "^6.5.2",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "jose": "^5.10.0",
    "puppeteer-core": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.32",
    "@types/aws-lambda": "^8.10.149",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.18.0",
    "memfs": "^4.14.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.0"
  }
}
