{
  "name": "report-service",
  "version": "1.0.0",
  "description": "Report generation service — NestJS REST API (ECS Fargate) + Lambda SQS workers + DynamoDB + S3 Files + SES",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:lambda:pdf": "esbuild src/workers/handlers/pdf.worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/pdf-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets",
    "build:lambda:csv": "esbuild src/workers/handlers/csv.worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/csv-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core",
    "build:lambda:xlsx": "esbuild src/workers/handlers/xlsx.worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/xlsx-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core",
    "build:lambda:txt": "esbuild src/workers/handlers/txt.worker.ts --bundle --platform=node --target=node20 --outfile=dist/workers/txt-worker.js --external:@aws-sdk/* --external:class-transformer --external:class-validator --external:@nestjs/microservices --external:@nestjs/websockets --external:pdfkit --external:puppeteer-core --external:exceljs",
    "build:lambdas": "npm run build:lambda:pdf && npm run build:lambda:csv && npm run build:lambda:xlsx && npm run build:lambda:txt",
    "build:docker": "docker build -t report-service-api .",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "seed:local": "tsx scripts/seed-local.ts",
    "start:local": "dotenv -e .env.local -- cross-env LOCAL=true nest start --watch",
    "start:workers:local": "dotenv -e .env.local -- cross-env LOCAL=true tsx scripts/start-local-workers.ts",
    "bootstrap:local": "dotenv -e .env.local -- tsx scripts/bootstrap-local.ts",
    "local:up": "npm run bootstrap:local",
    "local:dev": "dotenv -e .env.local -- cross-env LOCAL=true tsx scripts/local-dev.ts",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && npm run local:up"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/metrics": "^2.33.0",
    "@aws-lambda-powertools/tracer": "^2.33.0",
    "@aws-sdk/client-dynamodb": "^3.1047.0",
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/client-ses": "^3.1047.0",
    "@aws-sdk/client-sqs": "^3.1047.0",
    "@aws-sdk/lib-dynamodb": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@sparticuz/chromium-min": "^148.0.0",
    "cross-env": "^10.1.0",
    "csv-stringify": "^6.7.0",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "jose": "^6.2.3",
    "puppeteer-core": "^25.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/core": "^1.15.33",
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "memfs": "^4.57.2",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  }
}
