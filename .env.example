# DynamoDB
JOBS_TABLE_NAME=report_jobs
TEMPLATES_TABLE_NAME=report_templates

# S3
TEMPLATE_BUCKET_NAME=report-service-templates-dev
OUTPUT_BUCKET_NAME=report-service-outputs-dev

# SQS Queues
SQS_PDF_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/report-pdf-queue
SQS_CSV_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/report-csv-queue
SQS_XLSX_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/report-xlsx-queue
SQS_TXT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/report-txt-queue

# JWT Auth (one of these required)
JWT_SECRET=your-256-bit-secret
# JWT_JWKS_URI=https://your-auth-provider/.well-known/jwks.json

# SES
SES_FROM_ADDRESS=noreply@yourdomain.com

# AWS
AWS_REGION=us-east-1
# Optional local/custom endpoints
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_DYNAMODB_ENDPOINT=http://localhost:4566
# AWS_SQS_ENDPOINT=http://localhost:4566
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_SES_ENDPOINT=http://localhost:4566

# S3 Files NFS mounts (Lambda env)
TEMPLATES_MOUNT_PATH=/mnt/templates
OUTPUTS_MOUNT_PATH=/mnt/outputs

# Logging
LOG_LEVEL=INFO
